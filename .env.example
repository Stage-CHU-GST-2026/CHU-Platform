# ── Server ─────────────────────────────────
HOST="0.0.0.0"
PORT=10000
RELOAD=true

# ── Database (PostgreSQL) ─────────────────
# Configure the Postgres container. docker-compose.yaml reads these from .env
# and the API derives DATABASE_URL from them, so everything stays in sync.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="app"
POSTGRES_PORT=19997

# Connection string used by the API / agent (python-dotenv interpolates ${VAR})
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# ── LLM Agent ──────────────────────────────
# Custom OpenAI-compatible endpoint (local)
#OPENAI_BASE_URL="http://localhost:6060/v1"
OPENAI_BASE_URL="https://api.deepseek.com"
# OPENAI_BASE_URL="https://deposit-redhead-destinations-explore.trycloudflare.com/v1"
# https://api.groq.com/openai/v1
OPENAI_API_KEY=""

AGENT_MODEL=deepseek-v4-flash
# AGENT_MODEL=rafw007/gemma4-e4b-claude-coder:latest
CHARTS_DIR="static/charts"
