# ═══════════════════════════════════════════
# CHU Platform — Environment Configuration
# Copy this file to .env and fill in values.
# ═══════════════════════════════════════════

# ── Server ─────────────────────────────────
HOST="0.0.0.0"
PORT=10000
RELOAD=true

# ── Charts ─────────────────────────────────
# Directory (relative to project root) where generated charts are saved
# and served as static files at /api/v1/charts/.
CHARTS_DIR="static/charts"

# ── Database (PostgreSQL) ──────────────────
# Full connection string (takes precedence over individual PG_* vars)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/app"

# Or set individual components (used by docker-compose):
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
POSTGRES_PORT=5432

# ── LLM / AI Agent ─────────────────────────
# Base URL for the OpenAI-compatible endpoint
OPENAI_BASE_URL="http://localhost:6060/v1"
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# API key for the LLM provider
OPENAI_API_KEY="api-herz"

# Agent defaults
AGENT_MODEL="gpt-4o-mini"
AGENT_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=15

# ── pgAdmin (optional) ─────────────────────
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="admin"
PGADMIN_PORT=5050
